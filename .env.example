# Copy to .env and fill in. Never commit .env.

# "production" hides /docs, /redoc and /openapi.json
ENVIRONMENT=development

# Meta model APIs (Muse, SAM 3.1, Meta ASR)
META_API_KEY=
META_BASE_URL=
MODEL_NAME=
# SEGMENT_MODEL_NAME=sam-3.1
# TRANSCRIBE_MODEL_NAME=muse-voice-transcribe-1.0
# IMAGE_MODEL_NAME=muse-image-1.0

# Postgres, e.g. postgres://user:password@host:port/db?sslmode=require
DB_URI=

# Vercel Blob for images; Postgres keeps the links. On Vercel, connect a public Blob
# store to the project instead. Unset locally: images stay in .media/.
# BLOB_READ_WRITE_TOKEN=

# Where images in .media/ are served from (docker-compose sets its own)
PUBLIC_BASE_URL=http://localhost:2024

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=

# docker compose: public HTTPS tunnel
NGROK_AUTHTOKEN=
